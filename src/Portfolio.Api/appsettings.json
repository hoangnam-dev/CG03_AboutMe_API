{
  "AllowedHosts": "*",
  "BootstrapAdmin": {
    "Enabled": false,
    "Email": "",
    "Password": ""
  },
  "ConnectionStrings": {
    "PostgreSql": ""
  },
  "Frontend": {
    "Origins": []
  },
  "Jwt": {
    "Issuer": "Portfolio.Api",
    "Audience": "Portfolio.Frontend",
    "ActiveKeyId": "",
    "SigningCertificatePath": "",
    "SigningCertificatePassword": "",
    "ValidationCertificatePaths": {},
    "AccessTokenMinutes": 10,
    "ClockSkewSeconds": 30
  },
  "RefreshToken": {
    "IdleLifetimeDays": 7,
    "AbsoluteLifetimeDays": 30,
    "Pepper": "",
    "CookieName": "__Host-refresh",
    "CsrfCookieName": "__Host-csrf",
    "CookieSameSite": "Lax"
  },
  "RateLimit": {
    "Auth": {
      "LoginPermitLimit": 5,
      "RefreshPermitLimit": 30,
      "WindowSeconds": 60
    },
    "Contact": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "SupabaseStorage": {
    "Url": "",
    "ServiceRoleKey": "",
    "RequestTimeoutSeconds": 30,
    "MaxResponseBytes": 65536,
    "Buckets": {
      "Avatars": "avatars",
      "ProjectImages": "project-images",
      "SkillIcons": "skill-icons",
      "CertificateFiles": "certificate-files",
      "CvFiles": "cv-files"
    }
  },
  "Upload": {
    "MaxFileSize": 10485760,
    "MaxHeroImageWidth": 8192,
    "MaxHeroImageHeight": 8192,
    "MaxProjectGalleryFiles": 10
  },
  "SkillIcons": {
    "MaxFileSize": 524288,
    "AllowedExternalHosts": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": ["FromLogContext"]
  }
}
