{
  "AllowedHosts": "*",
  "BootstrapAdmin": {
    "Enabled": false,
    "Email": "",
    "Password": ""
  },
  "ConnectionStrings": {
    "PostgreSql": ""
  },
  "Frontend": {
    "Origin": ""
  },
  "Jwt": {
    "Issuer": "Portfolio.Api",
    "Audience": "Portfolio.Frontend",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "SupabaseStorage": {
    "Url": "",
    "ServiceRoleKey": "",
    "RequestTimeoutSeconds": 30,
    "MaxResponseBytes": 65536,
    "Buckets": {
      "Avatars": "avatars",
      "ProjectImages": "project-images",
      "CertificateFiles": "certificate-files",
      "CvFiles": "cv-files"
    }
  },
  "Upload": {
    "MaxFileSize": 10485760,
    "MaxHeroImageWidth": 8192,
    "MaxHeroImageHeight": 8192
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": ["FromLogContext"]
  }
}
