{
  "Frontend": {
    "Origins": [
      "http://localhost:3000",
      "https://localhost:44313",
      "https://localhost:7097"
    ]
  },
  "Jwt": {
    "AccessTokenMinutes": 10,
    "ClockSkewSeconds": 30
  },
  "RefreshToken": {
    "IdleLifetimeDays": 7,
    "AbsoluteLifetimeDays": 30,
    "CookieName": "__Host-refresh",
    "CsrfCookieName": "__Host-csrf",
    "CookieSameSite": "Lax"
  },
  "RateLimit": {
    "Auth": {
      "LoginPermitLimit": 5,
      "RefreshPermitLimit": 30,
      "WindowSeconds": 60
    },
    "Contact": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  }
}
